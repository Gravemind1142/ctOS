# GENERATED by design/build.py from design/templates/extras/.config/hypr/ctos-hyprbars.conf.tmpl.
# Do not edit by hand. Change design/tokens.json or the template and run design/build.py.
#
# ctOS title strip, drawn by the hyprbars plugin (DESIGN.md -> Shape, motif 1).
# Needs the plugin installed and enabled first:
#   hyprpm update
#   hyprpm add https://github.com/hyprwm/hyprland-plugins
#   hyprpm enable hyprbars
# then source this AFTER ctos-look.conf:
#   source = /opt/ctos/extras/.config/hypr/ctos-hyprbars.conf
# If a Hyprland update breaks the plugin, remove the source line and the desktop
# falls back to the plain ctos-look frame.

# load enabled plugins at startup (-n: no notification)
exec-once = hyprpm reload -n

plugin {
    hyprbars {
        bar_height = {{windowTitleHeight}}
        bar_color = rgb({{windowTitleBackground|bare}})
        col.text = rgb({{windowTitleText|bare}})
        bar_text_font = {{fontInsider}}
        bar_text_size = {{windowTitleTextSize}}
        bar_text_align = left
        bar_padding = {{windowTitlePadding}}
        bar_button_padding = {{spaceXs}}

        # the border wraps the strip and the strip is filled in the border's
        # colour, so frame + strip read as one solid block
        bar_part_of_window = true
        bar_precedence_over_border = true
        bar_blur = false

        # the reference's small square icon, left of the title: maximise
        bar_buttons_alignment = left
        icon_on_hover = false
        # bgcolor, size, icon, on-click, fgcolor
        hyprbars-button = rgba({{windowTitleBackground|bare}}00), {{fontSizeXs}}, □, hyprctl dispatch fullscreen 1, rgb({{windowTitleText|bare}})

        on_double_click = hyprctl dispatch fullscreen 1
    }
}

# the strip follows the border: inactive colour by default (bar_color above),
# active colour on the focused window
windowrule {
    name = ctos-hyprbars-focus
    match:focus = true
    hyprbars:bar_color = rgb({{windowTitleBackgroundActive|bare}})
}
