# GENERATED by design/build.py from design/templates/extras/.config/hypr/ctos-look.conf.tmpl.
# Do not edit by hand. Change design/tokens.json or the template and run design/build.py.
#
# ctOS window look: square, outlined, opaque windows that tile with a narrow gutter
# (DESIGN.md -> Shape, Motion). Source this AFTER your own settings so it wins:
#   source = /opt/ctos/extras/.config/hypr/ctos-look.conf

general {
    border_size = {{windowBorder}}
    gaps_in = {{windowGapsIn}}
    gaps_out = {{windowGapsOut}}

    # solid colours, no gradients
    col.active_border = rgb({{windowBorderActive|bare}})
    col.inactive_border = rgb({{windowBorderInactive|bare}})
}

decoration {
    rounding = {{radius}}

    # depth comes from outlines, not shadows; surfaces are opaque
    shadow {
        enabled = false
    }
    blur {
        enabled = false
    }
}

# tabbed groups: tabs follow the controls spec (active tab is an inverted block)
group {
    col.border_active = rgb({{windowBorderActive|bare}})
    col.border_inactive = rgb({{windowBorderInactive|bare}})
    col.border_locked_active = rgb({{windowBorderActive|bare}})
    col.border_locked_inactive = rgb({{windowBorderInactive|bare}})

    groupbar {
        font_family = {{fontInsider}}
        font_size = {{windowTitleTextSize}}
        height = {{windowTitleHeight}}
        gradients = true
        rounding = {{radius}}
        gradient_rounding = {{radius}}
        indicator_height = 0
        col.active = rgb({{labelFill|bare}})
        col.inactive = rgb({{backgroundBright|bare}})
        text_color = rgb({{labelText|bare}})
        text_color_inactive = rgb({{textSecondary|bare}})
    }
}

# speeds are in deciseconds; curves come from the easing tokens
animations {
    enabled = true

    bezier = ctosEnter, {{easeEnter|bezier}}
    bezier = ctosExit, {{easeExit|bezier}}
    bezier = ctosMove, {{easeMove|bezier}}
    bezier = ctosSnap, {{easeSnap|bezier}}
    bezier = ctosLinear, {{easeLinear|bezier}}

    animation = global, 1, {{durationMedium|ds}}, ctosMove
    animation = border, 1, {{durationFast|ds}}, ctosLinear
    animation = windowsIn, 1, {{durationShort|ds}}, ctosEnter, popin 95%
    animation = windowsOut, 1, {{durationFast|ds}}, ctosExit, popin 95%
    animation = windowsMove, 1, {{durationMedium|ds}}, ctosMove
    animation = fadeIn, 1, {{durationShort|ds}}, ctosEnter
    animation = fadeOut, 1, {{durationFast|ds}}, ctosExit
    animation = fade, 1, {{durationShort|ds}}, ctosMove
    animation = layersIn, 1, {{durationShort|ds}}, ctosEnter, fade
    animation = layersOut, 1, {{durationFast|ds}}, ctosExit, fade
    animation = workspaces, 1, {{durationMedium|ds}}, ctosMove, slide
}
