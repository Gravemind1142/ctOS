    "syntax": {
        "syntaxText": "{gray200}",
        "syntaxComment": "{gray500}",
        "syntaxPunctuation": "{gray250}",
        "syntaxKeyword": "{white}",
        "syntaxString": "{green400}",
        "syntaxConstant": { "value": "{cyan400}", "description": "Numbers, booleans, constants" },
        "syntaxFunction": "{blue400}",
        "syntaxType": { "value": "{violet400}", "description": "Types, classes, interfaces" },
        "syntaxSpecial": { "value": "{amber400}", "description": "Escapes, regex, decorators, macros" },
        "syntaxError": "{error}",
        "syntaxWarning": "{warning}",
        "syntaxInfo": "{textAccent}",
        "syntaxHint": "{textSecondary}",
        "diffAdded": "{success}",
        "diffRemoved": "{error}",
        "diffChanged": "{warning}"
    }
