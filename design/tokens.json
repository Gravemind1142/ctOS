{
    "$schema": "./tokens.schema.json",
    "primitives": {
        "black": "#000000",
        "white": "#ffffff",
        "ink900": {
            "value": "#05080b",
            "description": "Blue-black of the hacker terminals and panel screens (sampled #000810)"
        },
        "ink800": "#0b0f13",
        "ink700": "#151a20",
        "ink600": { "value": "#262c33", "description": "Inner dividers and table rules" },
        "ink500": { "value": "#3a424b", "description": "Muted data fills, e.g. the map landmass (sampled #384048)" },
        "gray100": { "value": "#e0e0e0", "description": "Inverted label fill (sampled #e0e0e0 from the dossier)" },
        "gray200": "#d9d9d9",
        "gray250": "#cacaca",
        "gray300": { "value": "#b8b8bf", "description": "Phone sub-labels (sampled #b8b8c0)" },
        "gray500": "#7a7a7a",
        "gray600": "#4a4f55",
        "cyan300": { "value": "#5ae6f0", "description": "Hack marker triangle and selection ring (sampled #58e8f0)" },
        "cyan400": { "value": "#33bdea", "description": "WD1 profiler cyan" },
        "cyan600": { "value": "#2c9fb6", "description": "Dossier category bar (sampled #30a0b8)" },
        "teal300": { "value": "#86e2cc", "description": "Network line nodes, bright (sampled #80d8c0-#90f0d8)" },
        "teal700": { "value": "#2e6f6c", "description": "Network lines, at rest (sampled #307070)" },
        "green400": { "value": "#4ef03a", "description": "Terminal phosphor green, 'bash*' (sampled #50f038)" },
        "green700": { "value": "#3f8a30", "description": "Dim terminal green (sampled #408830)" },
        "red400": { "value": "#f5412a", "description": "Dossier red lifted for text contrast" },
        "red500": { "value": "#cc1c06", "description": "Dossier category bar (sampled #c81800-#d01800)" },
        "rose500": { "value": "#c8406a", "description": "Phone 'secured network' badge (sampled #c84068)" },
        "red300": { "value": "#ff7a66", "description": "Bright red (terminal)" },
        "green300": { "value": "#a2f797", "description": "Bright green (terminal)" },
        "amber400": {
            "value": "#e5b422",
            "description": "Extended palette: not in the references, added for warnings and the terminal"
        },
        "amber300": { "value": "#f5d36b", "description": "Bright amber (terminal)" },
        "blue400": { "value": "#5875ec", "description": "Terminal prompt blue (sampled #3048b0), lifted to 4.9:1" },
        "blue300": { "value": "#8fa3ff", "description": "Bright blue (terminal)" },
        "violet400": { "value": "#ad66f0", "description": "Terminal magenta (sampled #400070), lifted to 5.7:1" },
        "violet300": { "value": "#d39cf7", "description": "Bright violet (terminal)" }
    },
    "colors": {
        "background": "{ink900}",
        "surface": { "value": "{ink800}", "description": "Panels that sit on the background" },
        "surfaceRaised": { "value": "{ink700}", "description": "Raised surface: hover rows, input wells" },
        "backgroundBright": { "value": "{surfaceRaised}", "deprecated": "surfaceRaised" },
        "scrim": { "value": "#000000cc", "description": "Behind modal overlays" },
        "tint": { "value": "#ffffff1e", "description": "Faint white wash behind an image or avatar" },
        "ctosGray": { "value": "{gray200}", "deprecated": "frame (outlines, brackets) or labelFill (filled blocks)" },
        "frame": { "value": "{gray200}", "description": "Panel and window outlines" },
        "frameSubtle": { "value": "{ink600}", "description": "Inner dividers, table rules, inactive outlines" },
        "fillMuted": { "value": "{ink500}", "description": "Meter tracks and inactive data shapes" },
        "textPrimary": "{white}",
        "textPrimaryDim": "{gray250}",
        "textPrimaryDimmer": "{gray300}",
        "textSecondary": "{gray500}",
        "secondary": { "value": "{gray500}", "deprecated": "textSecondary (text) or frameSubtle (rules)" },
        "textDisabled": "{gray600}",
        "textAccent": "{cyan400}",
        "labelFill": { "value": "{gray100}", "description": "Inverted label block (SMART PHONE, INSURANCE)" },
        "labelText": { "value": "{black}", "description": "Text on any filled block: label, info, error" },
        "infoFill": { "value": "{cyan600}", "description": "Category tag fill" },
        "errorFill": { "value": "{red500}", "description": "Alert tag fill" },
        "focus": { "value": "{cyan300}", "description": "Focus/selection ring and hack marker. The system's attention" },
        "networkLine": "{teal700}",
        "networkNode": "{teal300}",
        "success": "{green400}",
        "successDim": "{green700}",
        "error": "{red400}",
        "warning": { "value": "{amber400}", "description": "Needs attention but hasn't failed: low battery, degraded link" },
        "secured": { "value": "{rose500}", "description": "Locked or protected badge (WPA network, encrypted device)" }
    },
    "typography": {
        "fontInsider": { "value": "JetBrainsMono Nerd Font", "description": "Insider voice (monospace)" },
        "fontPublic": { "value": "Nimbus Sans", "description": "Public voice (Helvetica-style neo-grotesk)" },
        "fontSize2xs": { "value": 11, "description": "Micro labels under a value (FREE, WPA PASSWORD)" },
        "fontSizeXs": 12,
        "fontSizeSm": { "value": 14, "description": "Default body and field labels" },
        "fontSizeMd": { "value": 16, "description": "Bar segments, inputs" },
        "fontSizeLg": 18,
        "fontSizeXl": { "value": 22, "description": "Profiler values, card titles" },
        "fontSizeDisplaySm": 34,
        "fontSizeDisplayMd": 48,
        "fontSizeDisplayLg": { "value": 64, "description": "Greeter splash wordmark" },
        "fontWeightLight": 300,
        "fontWeightRegular": 400,
        "fontWeightMedium": 500,
        "fontWeightBold": 600,
        "trackingNone": 0,
        "trackingLabel": { "value": 1, "description": "Uppercase labels" },
        "trackingWide": { "value": 5, "description": "Masked input, spaced readouts" }
    },
    "spacing": {
        "space2xs": 2,
        "spaceXs": 4,
        "spaceSm": 6,
        "spaceMd": 8,
        "spaceLg": 12,
        "spaceXl": 16,
        "space2xl": 24,
        "space3xl": 32,
        "barHeight": 37,
        "segmentInset": { "value": 3, "description": "Gap between a bar segment's corner frame and the bar edge" },
        "barMeterWidth": { "value": 90, "description": "Content width of a bar meter (label, value and fill)" },
        "popupWidth": { "value": 240, "description": "Width of a menu dropped from a bar segment" },
        "popupWidthWide": { "value": 300, "description": "Width of a bar menu that lists names (network list)" }
    },
    "shape": {
        "radius": { "value": 0, "description": "Containers are always square" },
        "strokeHairline": { "value": 1, "description": "Bar border, dividers, corner brackets, network lines" },
        "strokeFrame": { "value": 2, "description": "Panel and window outlines" },
        "strokeMarker": { "value": 3, "description": "Hack marker and focus ring" },
        "cornerArm": { "value": 7, "description": "Length of a corner bracket arm" },
        "accentSize": { "value": 4, "description": "Size of a greeter accent square" },
        "accentSizeSm": { "value": 2, "description": "Accent squares around a small bar icon" },
        "crosshairSize": { "value": 9, "description": "Active-workspace crosshair" },
        "statusDot": { "value": 6, "description": "Round status dot on a badge or bar icon" },
        "pipSize": { "value": 3, "description": "Workspace window pip: one per extra window" },
        "labelShadow": { "value": 2, "description": "Hard offset shadow under stacked tags" }
    },
    "controls": {
        "controlHeight": { "value": 28, "description": "Buttons, entries, combo boxes. Compact for desktop density" },
        "controlPadding": "{spaceMd}",
        "indicatorSize": { "value": 14, "description": "Checkbox and radio box" },
        "badgeSize": { "value": 24, "description": "Round icon badge at the start of a list row (network list)" },
        "trackThickness": { "value": 2, "description": "Slider and progress track" },
        "handleSize": { "value": 12, "description": "Slider handle (square)" },
        "scrollbarWidth": { "value": 4, "description": "Overlay scrollbar at rest" },
        "scrollbarWidthHover": 8,
        "focusRing": { "value": "{strokeFrame}", "description": "Focus outline on controls" }
    },
    "window": {
        "windowBorder": { "value": "{strokeFrame}", "description": "Compositor window border" },
        "windowBorderActive": "{frame}",
        "windowBorderInactive": { "value": "{textSecondary}", "description": "Dimmer, but still visible like the background windows in the references" },
        "windowGapsIn": { "value": "{spaceXs}", "description": "Half the gutter between tiled windows (8px total)" },
        "windowGapsOut": "{spaceMd}",
        "windowTitleHeight": { "value": 20, "description": "Title strip (hyprbars)" },
        "windowTitleBackground": "{background}",
        "windowTitleText": "{textSecondary}",
        "windowTitleTextSize": "{fontSize2xs}",
        "windowTitlePadding": "{spaceMd}"
    },
    "dedsec": {
        "dedsecBackground": { "value": "{black}", "description": "Takeover background: pure black, dropping ctOS's blue cast" },
        "dedsecText": "{white}",
        "dedsecSignal": { "value": "{error}", "description": "The one fact that caused the breach" },
        "durationGlitch": { "value": "{durationInstant}", "description": "One glitch frame during erosion" }
    },
    "opacity": {
        "opacityGhost": { "value": 0.1, "description": "A trace left behind as something leaves" },
        "opacityDim": { "value": 0.5, "description": "Content pushed back: behind a modal, disabled imagery" },
        "opacitySoft": { "value": 0.9, "description": "Imagery under or beside text, so it doesn't outshine it" }
    },
    "motion": {
        "durationInstant": { "value": 50, "description": "Opacity blips, glitch frames" },
        "durationFast": { "value": 100, "description": "Hover, press, accent slide" },
        "durationShort": { "value": 200, "description": "Small elements entering or leaving" },
        "durationMedium": { "value": 300, "description": "Panels, popups, layout shifts" },
        "durationLong": { "value": 500, "description": "Screen-level transitions" },
        "durationMeter": { "value": 1000, "description": "Meter fill following a new value" },
        "durationHack": { "value": 2000, "description": "Canonical hack-in-progress fill" },
        "easeEnter": { "value": "OutCubic", "type": "easing", "description": "Arriving: fast start, soft landing" },
        "easeExit": { "value": "InExpo", "type": "easing", "description": "Leaving: holds, then snaps away" },
        "easeMove": { "value": "InOutCubic", "type": "easing", "description": "Moving or resizing in place" },
        "easeSnap": { "value": "OutExpo", "type": "easing", "description": "Accent slides, typewriter caret" },
        "easeLinear": { "value": "Linear", "type": "easing", "description": "Progress fills" }
    },
    "terminal": {
        "terminalBackground": "{background}",
        "terminalForeground": "{gray200}",
        "terminalCursor": "{textPrimary}",
        "terminalSelectionBackground": "{labelFill}",
        "terminalSelectionForeground": "{labelText}",
        "ansiBlack": "{ink700}",
        "ansiRed": "{red400}",
        "ansiGreen": "{green400}",
        "ansiYellow": "{amber400}",
        "ansiBlue": "{blue400}",
        "ansiMagenta": "{violet400}",
        "ansiCyan": "{cyan400}",
        "ansiWhite": "{gray250}",
        "ansiBrightBlack": "{gray500}",
        "ansiBrightRed": "{red300}",
        "ansiBrightGreen": "{green300}",
        "ansiBrightYellow": "{amber300}",
        "ansiBrightBlue": "{blue300}",
        "ansiBrightMagenta": "{violet300}",
        "ansiBrightCyan": "{cyan300}",
        "ansiBrightWhite": "{white}"
